# Bu dosyayi .env olarak kopyalayin. .env asla commit edilmez.
# Faz 0 tamamen tarayicida calisir ve .env OLMADAN da varsayilanlarla acilir.

# ── Sadece Node tarafi (replay, ileride cook) ───────────────────────────

# Oyuncunun orijinal BFME/RotWK kurulumu. Asset okuma buradan yapilir.
# Bu yol repoya ASLA kopyalanmaz.
# Faz 1'de kullanilacak.
BFME_GAME_PATH=

# Pisirilmis asset cache'i
# Faz 1'de kullanilacak.
BFME_CACHE_DIR=./.cache/cooked

# Icerik paketlerinin kok dizini
BFME_CONTENT_DIR=./content

# ── Client tarafi (Vite uzerinden expose edilir) ────────────────────────

VITE_BFME_LOG_LEVEL=debug          # trace | debug | info | warn | error
VITE_BFME_ENABLED_MODS=base        # virgulle ayrilmis, yukleme sirasinda
VITE_BFME_HOT_RELOAD=true          # icerik dosyasi degisince sicak yukleme
VITE_BFME_SIM_TRACE=false          # her tick'te state hash'i logla (yavas)
VITE_BFME_TICK_RATE=30             # sadece gelistirme icin; uretimde sabit
VITE_BFME_SHOW_STATS=true          # fps / tick / entity sayaci overlay
VITE_BFME_SEED=42                  # demo senaryosunun tohumu (0..4294967295)
